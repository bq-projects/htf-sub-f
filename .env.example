# Supabase (pre-populated — do not change)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Qwen3-4B Open-Weight Model (Ollama or compatible)
OPEN_MODEL_BASE_URL=http://localhost:11434
OPEN_MODEL_NAME=qwen3:4b
OPEN_MODEL_API_KEY=

# Google Gemini API (Creative Intelligence)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs API (Voice Intelligence)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# NEVER commit real secrets to Git.
# Only use this file as a template for your own .env
